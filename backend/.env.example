# Mongo connection, same variable name acadza-backend uses
MONGO_DEV_URI=mongodb://127.0.0.1:27017/acadza-schools
# JWT secret, same variable name acadza-backend uses
TOKEN_SECRET=replace-with-a-long-random-string
# 4000, not 5000: on macOS the AirPlay Receiver in Control Centre listens on 5000 already.
PORT=4000

# OTP delivery. acadza-backend sends the registration OTP over SMS; this project has no SMS
# provider wired, so the code is printed to the server console instead. With OTP_DEV_CODE set,
# that fixed code is used for every send, which is what makes the signup flow testable locally.
OTP_DEV_CODE=123456
