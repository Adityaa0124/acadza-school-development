# Copy to .env in the repo root:  copy .env.docker.example .env
# docker-compose reads it automatically for variable substitution.

# MongoDB connection string. For MongoDB Atlas this is a mongodb+srv:// URI,
# e.g. mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/acadza-schools?retryWrites=true&w=majority
# Use a password with letters/numbers only (no @ # / etc.) to avoid URL-encoding.
MONGO_DEV_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/acadza-schools?retryWrites=true&w=majority

# Long random string used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=change-me-to-a-long-random-string

# The URL the BROWSER uses to reach the backend. Use http://localhost:4000
# when opening the site on this machine; use http://<your-lan-ip>:4000 if
# opening it from another device on your network.
NEXT_PUBLIC_API_URL=http://localhost:4000
